# MenuFlow POS — environment (set these as Railway service variables; never commit real values)

# REQUIRED on Railway. The server refuses to boot without it. Use a long passphrase.
OWNER_PASSWORD=

# Optional. Extra entropy for the session-signing key. Rotating it signs everyone out.
SESSION_SECRET=

# Railway volume mount path. State lives at $MENUFLOW_DATA_DIR/state.json.
# Attach a volume to the service mounted at /data, then set:
MENUFLOW_DATA_DIR=/data

# Keeps the legacy AI Studio Firebase project disconnected on hosted deploys.
# Remove once a Firebase project you own is configured.
MENUFLOW_FIREBASE=off

# Injected by Railway; do not set.
# PORT=
