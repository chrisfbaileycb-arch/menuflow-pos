      "kind": "auto",
      "title": "Find conflicts: deep stacks, dead force rules, post-tax suspects",
      "skill": "audit.pricing",
      "args": {},
      "citations": [
        {
          "doc": "heartland.kb.pricing-rules",
          "section": "audit-conflicts"
        },
        {
          "doc": "heartland.manual",
          "section": "discounts-vs-adjustments"
        }
      ]
    },
    {
      "id": "s-approve",
      "kind": "gate",
      "title": "Owner approves rule changes (they move real money)",
