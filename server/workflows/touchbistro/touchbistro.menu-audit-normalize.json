{
  "platform": "touchbistro",
  "id": "touchbistro.menu-audit-normalize",
  "category": "audit",
  "risk": "medium",
  "title": "Audit + normalize (TouchBistro build)",
  "summary": "Full pipeline: audit, gate, normalize, isolate, course sweep, shadow channels, verification checks.",
  "inputs": [
    {
      "name": "fixModifier",
      "type": "string",
      "required": false,
      "example": "Pepperoni"
    }
  ],
  "steps": [
    {
      "id": "s-audit",
      "kind": "auto",
      "title": "Run the full menu audit and write the client report",
      "skill": "audit.full",
      "args": {},
      "citations": [
        {
          "doc": "heartland.kb.audit-protocol",
          "section": "protocol"
        }
      ]
    },
    {
      "id": "s-gate",
      "kind": "gate",
      "title": "Client approval of audit findings + scope",
      "instructions": "Present the audit report (HIGH/MEDIUM findings, 86-cascade exposure). Obtain WRITTEN approval for the scope: targeted fix vs full normalization. Never touch the live system before this gate."
    },
    {
      "id": "s-norm",
      "kind": "auto",
      "title": "Normalize casing/prices/options",
      "skill": "menu.normalize",
      "args": {}
    },
    {
      "id": "s-iso",
      "kind": "auto",
      "title": "Isolate the flagged modifier",
      "skill": "menu.modifier.isolate",
      "args": {
        "modifier": "{fixModifier}"
      },
      "fatal": false
    },
    {
      "id": "s-course",
      "kind": "auto",
      "title": "Coursing sweep",
      "skill": "audit.coursing",
      "args": {}
    },
    {
      "id": "s-shadow",
      "kind": "auto",
      "title": "Shadow v2 channels",
      "skill": "channel.shadow_create",
      "args": {}
    },
    {
      "id": "s-verify",
      "kind": "auto",
      "title": "Verify",
      "skill": "channel.shadow_verify",
      "args": {},
      "checks": [
        {
          "check": "shadow-verified"
        }
      ]
    }
  ]
}
