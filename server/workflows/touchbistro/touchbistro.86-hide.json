{
  "platform": "touchbistro",
  "id": "touchbistro.86-hide",
  "category": "operations",
  "risk": "low",
  "title": "86 = X next to POS (record stays)",
  "summary": "TouchBistro hides an item from POS ordering by clicking the X beside POS — the canonical reversible 86. Online Ordering visibility is a separate control and must be set deliberately.",
  "inputs": [
    {
      "name": "item",
      "type": "string",
      "required": true,
      "example": "Pepperoni Pizza"
    },
    {
      "name": "reason",
      "type": "string",
      "required": true,
      "example": "market miss — back Thursday"
    }
  ],
  "steps": [
    {
      "id": "s-cascade",
      "kind": "auto",
      "title": "Cascade exposure check",
      "skill": "audit.86-risk",
      "args": {},
      "citations": [
        {
          "doc": "heartland.kb.audit-protocol",
          "section": "never-86"
        }
      ]
    },
    {
      "id": "s-x",
      "kind": "manual",
      "title": "Click the X icon next to POS on the item",
      "instructions": "Menu > item > enable/disable: the X beside POS hides it from in-house ordering without deleting anything; leave the Online Ordering toggle as the situation demands (it is independent).",
      "citations": [
        {
          "doc": "touchbistro.menu-items",
          "section": "hide"
        },
        {
          "doc": "touchbistro.menu-items",
          "section": "online"
        }
      ]
    },
    {
      "id": "s-mirror",
      "kind": "auto",
      "title": "Mirror 86 on the workbench",
      "skill": "menu.item.86",
      "args": {
        "item": "{item}",
        "reason": "{reason}"
      },
      "fatal": false
    },
    {
      "id": "s-verify",
      "kind": "auto",
      "title": "Verify state",
      "skill": "menu.channel.list",
      "args": {},
      "checks": [
        {
          "check": "item-unavailable",
          "args": {
            "item": "{item}"
          },
          "fatal": false
        }
      ],
      "fatal": false
    }
  ]
}
