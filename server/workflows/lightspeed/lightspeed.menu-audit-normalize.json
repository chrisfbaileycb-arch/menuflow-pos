{
  "platform": "lightspeed",
  "id": "lightspeed.menu-audit-normalize",
  "category": "audit",
  "risk": "medium",
  "title": "Audit + normalize + shadows (K-Series build)",
  "summary": "Same Signal F pipeline, K-Series semantics: archive not delete; empty groups blocked; price-list sanity.",
  "inputs": [
    {
      "name": "fixModifier",
      "type": "string",
      "required": false,
      "example": "Pepperoni"
    }
  ],
  "steps": [
    {
      "id": "s-audit",
      "kind": "auto",
      "title": "Run the full menu audit and write the client report",
      "skill": "audit.full",
      "args": {},
      "citations": [
        {
          "doc": "heartland.kb.audit-protocol",
          "section": "protocol"
        },
        {
          "doc": "lightspeed.manual",
          "section": "audit-checklist"
        }
      ]
    },
    {
      "id": "s-gate",
      "kind": "gate",
      "title": "Client approval of audit findings + scope",
      "instructions": "Present the audit report (HIGH/MEDIUM findings, 86-cascade exposure). Obtain WRITTEN approval for the scope: targeted fix vs full normalization. Never touch the live system before this gate."
    },
    {
      "id": "s-norm",
      "kind": "auto",
      "title": "Normalize",
      "skill": "menu.normalize",
      "args": {}
    },
    {
      "id": "s-iso",
      "kind": "auto",
      "title": "Isolate shared modifier if flagged",
      "skill": "menu.modifier.isolate",
      "args": {
        "modifier": "{fixModifier}"
      },
      "fatal": false
    },
    {
      "id": "s-shadow",
      "kind": "auto",
      "title": "Shadow channels",
      "skill": "channel.shadow_create",
      "args": {}
    },
    {
      "id": "s-verify",
      "kind": "auto",
      "title": "Verify shadows",
      "skill": "channel.shadow_verify",
      "args": {},
      "checks": [
        {
          "check": "no-empty-modifier-groups"
        },
        {
          "check": "shadow-verified"
        }
      ]
    }
  ]
}
