    },
    {
      "id": "s-reorder",
      "kind": "auto",
      "title": "Re-sort rules most-specific-first",
      "skill": "menu.pricing.reorder_specificity",
      "args": {},
      "citations": [
        {
          "doc": "heartland.kb.pricing-rules",
          "section": "priority"
        }
      ]
    },
    {
      "id": "s-dead",
      "kind": "auto",
      "title": "Disable shadowed force rules (non-destructive)",
      "skill": "menu.pricing.disable_dead_force_rules",
      "args": {}
    },
    {
      "id": "s-verify",
      "kind": "auto",
      "title": "Verify no dead force rules remain",
      "skill": "audit.pricing",
      "args": {},
      "checks": [
        {
          "check": "no-dead-force-price"
        }
      ]
    },
    {
      "id": "s-fix",
      "kind": "auto",
      "title": "Confirm improvement vs baseline",
      "skill": "audit.verify_fix",
      "args": {
        "metric": "pricing"
      }
    }
  ]
}
