{
  "platform": "toast",
  "id": "toast.menu-audit-normalize",
  "category": "audit",
  "risk": "medium",
  "title": "Audit + normalize a migrated Toast menu (shadow build included)",
  "summary": "Runs the full audit set, gates on client approval, normalizes, isolates shared modifiers, and shadow-builds v2 channels on this console before any cutover discussion.",
  "inputs": [
    {
      "name": "fixModifier",
      "type": "string",
      "required": false,
      "example": "Pepperoni"
    }
  ],
  "steps": [
    {
      "id": "s-audit",
      "kind": "auto",
      "title": "Run the full menu audit and write the client report",
      "skill": "audit.full",
      "args": {},
      "citations": [
        {
          "doc": "heartland.kb.audit-protocol",
          "section": "protocol"
        }
      ]
    },
    {
      "id": "s-gate",
      "kind": "gate",
      "title": "Client approval of audit findings + scope",
      "instructions": "Present the audit report (HIGH/MEDIUM findings, 86-cascade exposure). Obtain WRITTEN approval for the scope: targeted fix vs full normalization. Never touch the live system before this gate."
    },
    {
      "id": "s-norm",
      "kind": "auto",
      "title": "Normalize names/casing/duplicate options",
      "skill": "menu.normalize",
      "args": {}
    },
    {
      "id": "s-iso",
      "kind": "auto",
      "title": "Isolate the flagged shared modifier",
      "skill": "menu.modifier.isolate",
      "args": {
        "modifier": "{fixModifier}"
      },
      "fatal": false
    },
    {
      "id": "s-shadow",
      "kind": "auto",
      "title": "Shadow-build v2 channels (Toast never sees anything until publish)",
      "skill": "channel.shadow_create",
      "args": {}
    },
    {
      "id": "s-verify",
      "kind": "auto",
      "title": "Verify shadows + sync-blockers",
      "skill": "channel.shadow_verify",
      "args": {},
      "checks": [
        {
          "check": "no-empty-modifier-groups"
        },
        {
          "check": "shadow-verified"
        }
      ]
    },
    {
      "id": "s-fixverify",
      "kind": "auto",
      "title": "Confirm finding-count improvement vs baseline",
      "skill": "audit.verify_fix",
      "args": {},
      "checks": [
        {
          "check": "no-empty-modifier-groups"
        }
      ]
    }
  ]
}
